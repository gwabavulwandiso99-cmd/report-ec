      "subcategories": {
        "no_supply":     {"requires_any": ["no_water"], "base_priority": "medium", "legacy_category": "no_water"},
        "burst_or_leak": {"requires_any": ["leak", "burst", "pipe"], "base_priority": "medium", "legacy_category": "water_leak"},
        "general":       {"requires_any": [], "base_priority": "medium", "legacy_category": "other"}
      }
    },
    "electricity": {
